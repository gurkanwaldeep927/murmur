{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "handoff-tests",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stage",
    "schema_version",
    "inputs_consumed",
    "status",
    "open_questions",
    "waivers_cited",
    "acceptance_criteria_map",
    "test_inventory",
    "runner"
  ],
  "properties": {
    "stage": {
      "const": "tests"
    },
    "schema_version": {
      "const": "1.0"
    },
    "inputs_consumed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "handoff_sha256"
        ],
        "properties": {
          "stage": {
            "type": "string"
          },
          "handoff_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "blocked"
      ]
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "owner",
          "blocking"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OQ-"
          },
          "text": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "waivers_cited": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "criterion_id",
          "criterion_source",
          "test_files",
          "level"
        ],
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "criterion_source": {
            "type": "string",
            "$comment": "PRD/TRD handoff field path"
          },
          "test_files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "level": {
            "enum": [
              "unit",
              "integration",
              "e2e",
              "contract",
              "property"
            ]
          }
        }
      }
    },
    "uncovered_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion_id",
          "reason"
        ],
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "test_inventory": {
      "type": "object",
      "required": [
        "unit",
        "integration",
        "e2e"
      ],
      "properties": {
        "unit": {
          "type": "integer",
          "minimum": 0
        },
        "integration": {
          "type": "integer",
          "minimum": 0
        },
        "e2e": {
          "type": "integer",
          "minimum": 0
        },
        "contract": {
          "type": "integer",
          "minimum": 0
        },
        "property": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "runner": {
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "framework": {
          "type": "string"
        }
      }
    }
  }
}