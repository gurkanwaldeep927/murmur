{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "handoff-observability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stage",
    "schema_version",
    "inputs_consumed",
    "status",
    "open_questions",
    "waivers_cited",
    "golden_signals",
    "checks",
    "smoke_run"
  ],
  "properties": {
    "stage": {
      "const": "observability"
    },
    "schema_version": {
      "const": "1.0"
    },
    "inputs_consumed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "handoff_sha256"
        ],
        "properties": {
          "stage": {
            "type": "string"
          },
          "handoff_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "blocked"
      ]
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "owner",
          "blocking"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OQ-"
          },
          "text": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "waivers_cited": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "golden_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "signal",
          "instrumented",
          "evidence"
        ],
        "properties": {
          "signal": {
            "enum": [
              "latency",
              "traffic",
              "errors",
              "saturation"
            ]
          },
          "instrumented": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "required": [
        "structured_logging",
        "no_pii_in_logs",
        "no_secrets_in_logs",
        "trace_propagation",
        "health_endpoint",
        "alert_rules_defined"
      ],
      "properties": {
        "structured_logging": {
          "type": "object",
          "required": [
            "passed",
            "evidence"
          ],
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "evidence": {
              "type": "string"
            }
          }
        },
        "no_pii_in_logs": {
          "type": "object",
          "required": [
            "passed",
            "evidence"
          ],
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "evidence": {
              "type": "string"
            }
          }
        },
        "no_secrets_in_logs": {
          "type": "object",
          "required": [
            "passed",
            "evidence"
          ],
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "evidence": {
              "type": "string"
            }
          }
        },
        "trace_propagation": {
          "type": "object",
          "required": [
            "passed",
            "evidence"
          ],
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "evidence": {
              "type": "string"
            }
          }
        },
        "health_endpoint": {
          "type": "object",
          "required": [
            "passed",
            "evidence"
          ],
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "evidence": {
              "type": "string"
            }
          }
        },
        "alert_rules_defined": {
          "type": "object",
          "required": [
            "passed",
            "evidence"
          ],
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "evidence": {
              "type": "string"
            }
          }
        }
      }
    },
    "smoke_run": {
      "type": "object",
      "required": [
        "performed",
        "evidence"
      ],
      "properties": {
        "performed": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "category",
          "location",
          "evidence",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(SEC|AIS|TST|PRF|OBS|RES|PRR)-[0-9]+$"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "category": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "provenance": {
            "type": "string",
            "$comment": "tool@version + rule id, or [ASSUMPTION]"
          },
          "fix_hint": {
            "type": "string"
          }
        }
      }
    }
  }
}