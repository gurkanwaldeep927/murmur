# Murmur — environment configuration (copy to .env for local dev)

# --- Server ---
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# --- Database (T4: managed Postgres) ---
# Local dev default; staging/prod supply their own DATABASE_URL.
DATABASE_URL=postgres://murmur:murmur@localhost:5432/murmur

# --- Identity / email-hash (T50: shared email-normalization + keyed-HMAC) ---
# Server-held HMAC pepper for email_hash computation. NEVER commit the real value.
# Versioned to support rotation (RR-13 / runbooks/pepper-rotation.md).
# Format: v<n>:<secret>  — the active version is used for new writes; older versions
# are retained (comma-separated) so existing ban_record/identity_account hashes still match.
EMAIL_HASH_PEPPER_ACTIVE=v1:change-me-in-every-real-environment
EMAIL_HASH_PEPPER_RETIRED=

# Application-layer encryption key for identity_account.email_encrypted (transient raw email).
# 32-byte key, base64-encoded. Rotated independently of the pepper.
EMAIL_ENCRYPTION_KEY=

# --- Sessions (T12: decisions/oq-14-session-mechanism.md) ---
# HMAC key for session tokens. A SEPARATE security domain from the email pepper above —
# do not reuse that value here. Versioned identically (v<n>:<secret>) so a rotation does
# not log every user out: new tokens are signed with the active key, while tokens signed
# with the retired key still verify until they expire.
SESSION_SIGNING_KEY=v1:change-me-in-every-real-environment
SESSION_SIGNING_KEY_RETIRED=
# Absolute session lifetime, and the age at which an in-use token is silently renewed
# via the X-Session-Refresh response header (sliding window).
SESSION_TTL_DAYS=30
SESSION_REFRESH_AFTER_DAYS=7

# --- Campus domain allowlist (single campus in v1 — app config, not a DB table) ---
# Comma-separated list of accepted college email domains.
CAMPUS_EMAIL_DOMAINS=example-college.edu

# --- Email/OTP Delivery Provider (T5) ---
# 'console' logs the token locally for dev; real environments set 'smtp' or a provider adapter.
EMAIL_PROVIDER=console
EMAIL_FROM=verify@murmur.example
# Verification token lifetime (minutes) and resend cooldown (seconds).
VERIFICATION_TOKEN_TTL_MINUTES=15
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# Rate limiting for A1 (verification initiation abuse protection).
VERIFICATION_MAX_ATTEMPTS_PER_WINDOW=5
VERIFICATION_RATE_WINDOW_MINUTES=60
